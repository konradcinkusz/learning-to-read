# Artefactos de compilación de LaTeX -- se regeneran con `make all`.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.pdf

# Generado por tools/gen_days.py a partir del JSON -- la fuente de
# verdad es el JSON, no estos ficheros.
content/generated-days.tex
content/generated-clave.tex
content/palabras/generated-days.tex
content/palabras/generated-clave.tex
content/lupa/generated-days.tex
content/lupa/generated-clave.tex
content/english/generated-days.tex
content/english/generated-clave.tex
content/firstwords/generated-days.tex
content/firstwords/generated-clave.tex
content/firstwords/generated-sonidos.tex
content/slowa/generated-days.tex
content/slowa/generated-clave.tex
content/zdania/generated-days.tex
content/zdania/generated-clave.tex
# ...y los de cada edición (tools/ediciones.py): el cuaderno de verano
# (generated-days-verano.tex, generated-clave-verano.tex...) y la muestra.
content/generated-*-verano.tex
content/*/generated-*-verano.tex
content/generated-*-muestra.tex
content/*/generated-*-muestra.tex

# Python
__pycache__/
*.pyc
